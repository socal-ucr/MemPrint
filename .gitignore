# Pin build outputs
obj-intel64/
*.o
*.so

# Workload sources are cloned and patched by scripts/setup.sh
workloads/src/

# Generated data (traces, run results, analysis outputs)
traces/
results/
data/
figures/
*.pdf
*.png

# Python
__pycache__/
*.pyc
.venv/

# Pin logs
pin.log
pintool.log

# The paper keeps its figures (regenerated by paper/make_figures.py) and its PDF
!paper/figures/
!paper/figures/*.pdf
!paper/memprint_timeline.pdf
paper/*.aux
paper/*.log
paper/*.bbl
paper/*.blg
paper/*.out
# The scheduling paper keeps its figures (paper_sched/make_figures.py) and its PDF
!paper_sched/figures/
!paper_sched/figures/*.pdf
!paper_sched/main.pdf
paper_sched/*.aux
paper_sched/*.log
paper_sched/*.bbl
paper_sched/*.blg
paper_sched/*.out
# The resizing paper keeps its figures (paper_resize/make_figures.py) and its PDF
!paper_resize/figures/
!paper_resize/figures/*.pdf
!paper_resize/main.pdf
paper_resize/*.aux
paper_resize/*.log
paper_resize/*.bbl
paper_resize/*.blg
paper_resize/*.out
# lit output
resize/tests/pass/Output/
resize/tests/pass/.lit_test_times.txt

# NVBit tool: the flush_channel fatbin and its bin2c array (gpu/nvbit_rw/Makefile)
gpu/nvbit_rw/tool_func/*.fatbin
gpu/nvbit_rw/tool_func/*.c
